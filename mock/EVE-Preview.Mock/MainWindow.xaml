<Window x:Class="EvePreview.Mock.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EVE-Preview Mock Client"
        Width="960" Height="600"
        MinWidth="480" MinHeight="320"
        Background="#0D141C">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="EVE-Preview Mock Client" Foreground="#F3F6F8" FontSize="30" FontWeight="SemiBold" />
            <TextBlock Text="仅用于验证原始预览与允许的窗口管理操作" Foreground="#9AA7B4" FontSize="14" Margin="0,8,0,24" />
        </StackPanel>
        <Border Grid.Row="1" BorderBrush="#334455" BorderThickness="1" CornerRadius="8" Background="#162432" Padding="24">
            <Grid>
                <Rectangle RadiusX="180" RadiusY="180" Fill="#193B52" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="ClockText" Text="--:--:--" Foreground="#4CC2FF" FontFamily="Consolas" FontSize="56" HorizontalAlignment="Center" />
                    <TextBlock Text="动态内容 / DWM 预览验证" Foreground="#F3F6F8" FontSize="18" Margin="0,16,0,0" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>
        <TextBlock x:Name="ProcessText" Grid.Row="2" Foreground="#9AA7B4" FontFamily="Consolas" FontSize="13" Margin="0,20,0,0" />
    </Grid>
</Window>
