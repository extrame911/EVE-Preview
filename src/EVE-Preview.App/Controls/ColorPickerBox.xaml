<UserControl x:Class="EvePreview.App.Controls.ColorPickerBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinHeight="30">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Button x:Name="PickButton"
                Style="{StaticResource SecondaryButtonStyle}"
                Padding="7,2"
                ToolTip="{Binding ToolTip, RelativeSource={RelativeSource AncestorType=UserControl}}"
                Click="OnPickClick">
            <StackPanel Orientation="Horizontal">
                <Border x:Name="Swatch"
                        Width="14"
                        Height="14"
                        CornerRadius="3"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        Background="Transparent" />
                <TextBlock x:Name="ValueText"
                           Margin="5,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="11"
                           FontFamily="{StaticResource MonospaceFontFamily}"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Button>
        <Button x:Name="ClearButton"
                Grid.Column="1"
                Margin="0"
                Padding="3,1"
                Width="40"
                MinWidth="0"
                Content="清空"
                ToolTip="{Binding Source=清除当前颜色，恢复到未选择或继承状态。, Converter={StaticResource LocalizationConverter}}"
                Style="{StaticResource SecondaryButtonStyle}"
                Visibility="Collapsed"
                Click="OnClearClick" />
    </Grid>
</UserControl>
