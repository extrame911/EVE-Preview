<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:EvePreview.App.Controls"
                    xmlns:behaviors="clr-namespace:EvePreview.App.Behaviors"
                    xmlns:vm="clr-namespace:EvePreview.App.ViewModels">
    <DataTemplate DataType="{x:Type vm:ThumbnailSettingsViewModel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,-14,0">
            <StackPanel>
                <controls:CutCornerPanel Style="{StaticResource CardStyle}" Header="基础尺寸与窗口"
                                         Icon="{StaticResource MonitorIconGeometry}" SectionCode="GEOMETRY / 01">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="宽度（像素）" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox ToolTip="{Binding Source=缩略图默认宽度，单位为物理像素；回车或失焦应用。, Converter={StaticResource LocalizationConverter}}" x:Name="DefaultWidthInput"
                                             Text="{Binding DefaultWidth, UpdateSourceTrigger=Explicit}" Margin="0,3,0,0"
                                             behaviors:CommitOnEnterOrLostFocus.IsEnabled="True" />
                                </Grid>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="高度（像素）" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox ToolTip="{Binding Source=缩略图默认高度，单位为物理像素；回车或失焦应用。, Converter={StaticResource LocalizationConverter}}" Width="{Binding ActualWidth, ElementName=DefaultWidthInput}" HorizontalAlignment="Left" Text="{Binding DefaultHeight, UpdateSourceTrigger=Explicit}" Margin="0,3,0,0"
                                             behaviors:CommitOnEnterOrLostFocus.IsEnabled="True" />
                                </Grid>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="不透明度（20–100%）" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox ToolTip="{Binding Source=缩略图内容不透明度，范围 20–100%；回车或失焦应用。, Converter={StaticResource LocalizationConverter}}" Width="{Binding ActualWidth, ElementName=DefaultWidthInput}" HorizontalAlignment="Left" Text="{Binding OpacityPercent, UpdateSourceTrigger=Explicit}" Margin="0,3,0,0"
                                             behaviors:CommitOnEnterOrLostFocus.IsEnabled="True" />
                                </Grid>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{Binding OpacityError}" Style="{StaticResource ErrorTextStyle}" />
                        <TextBlock Text="{Binding SizeLimitsText}" Style="{StaticResource CaptionTextStyle}"
                                   Margin="0,3,0,6" />
                        <StackPanel>
                            <CheckBox ToolTip="{Binding Source=开启后缩略图始终显示在其他普通窗口之上。, Converter={StaticResource LocalizationConverter}}" Content="缩略图置顶" IsChecked="{Binding IsTopmost}" Margin="0,5" />
                            <CheckBox ToolTip="{Binding Source=开启后禁用右键拖动和缩放，防止误移缩略图。, Converter={StaticResource LocalizationConverter}}" Content="锁定位置[禁用右键拖动]" IsChecked="{Binding LockPosition}" />
                        </StackPanel>
                    </StackPanel>
                </controls:CutCornerPanel>

                <controls:CutCornerPanel Style="{StaticResource CardStyle}" Header="可见性"
                                         Icon="{StaticResource EyeIconGeometry}" SectionCode="VISIBILITY / 02">
                    <StackPanel>
                        <Grid Margin="0,3,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <CheckBox ToolTip="{Binding Source=开启后，EVE 客户端失去前台焦点时隐藏其预览。, Converter={StaticResource LocalizationConverter}}" Content="隐藏失去焦点窗口预览" IsChecked="{Binding HideOnFocusLoss}"
                                      VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="延迟（毫秒）" Style="{StaticResource FieldLabelTextStyle}"
                                       Margin="12,0,8,0" />
                            <TextBox ToolTip="{Binding Source=失去焦点后延迟多少毫秒隐藏预览，范围 0–10000。, Converter={StaticResource LocalizationConverter}}" Grid.Column="2" Width="{Binding ActualWidth, ElementName=DefaultWidthInput}" HorizontalAlignment="Left" Text="{Binding HideDelayMilliseconds, UpdateSourceTrigger=Explicit}" behaviors:CommitOnEnterOrLostFocus.IsEnabled="True" />
                        </Grid>
                        <Grid Margin="0,3,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <CheckBox ToolTip="{Binding Source=开启后，EVE 客户端处于前台焦点时隐藏其预览。, Converter={StaticResource LocalizationConverter}}" Content="隐藏当前焦点窗口预览" IsChecked="{Binding HideActiveClient}"
                                      VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="延迟（毫秒）" Style="{StaticResource FieldLabelTextStyle}"
                                       Margin="12,0,8,0" />
                            <TextBox ToolTip="{Binding Source=EVE 客户端获得焦点后延迟多少毫秒隐藏预览，范围 0–10000。, Converter={StaticResource LocalizationConverter}}" Grid.Column="2" Width="{Binding ActualWidth, ElementName=DefaultWidthInput}" HorizontalAlignment="Left" Text="{Binding HideActiveDelayMilliseconds, UpdateSourceTrigger=Explicit}" behaviors:CommitOnEnterOrLostFocus.IsEnabled="True" />
                        </Grid>

                    </StackPanel>
                </controls:CutCornerPanel>

                <controls:CutCornerPanel Style="{StaticResource CardStyle}" Header="悬停缩放"
                                         Icon="{StaticResource ZoomIconGeometry}" SectionCode="PROXIMITY / 03">
                    <StackPanel>
                        <CheckBox ToolTip="{Binding Source=开启后鼠标悬停缩略图会放大并提高不透明度。, Converter={StaticResource LocalizationConverter}}" Content="鼠标悬停时放大并提高不透明度" IsChecked="{Binding HoverZoomEnabled}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="缩放倍数（1.00–4.00）" />
                                <TextBox ToolTip="{Binding Source=悬停放大倍数，范围 1.00–4.00。, Converter={StaticResource LocalizationConverter}}" Width="{Binding ActualWidth, ElementName=DefaultWidthInput}" HorizontalAlignment="Left" Text="{Binding HoverZoomFactor, UpdateSourceTrigger=Explicit}" Margin="0,3,0,0" behaviors:CommitOnEnterOrLostFocus.IsEnabled="True" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="九宫格缩放锚点" />
                                <ComboBox ToolTip="{Binding Source=选择悬停放大时缩略图向哪个方向扩展。, Converter={StaticResource LocalizationConverter}}" Width="{Binding ActualWidth, ElementName=DefaultWidthInput}" HorizontalAlignment="Left" SelectedValuePath="Tag" SelectedValue="{Binding ZoomAnchor}" Margin="0,3,0,0">
                                    <ComboBoxItem Content="{Binding Source=左上, Converter={StaticResource LocalizationConverter}}" Tag="左上" /><ComboBoxItem Content="{Binding Source=上, Converter={StaticResource LocalizationConverter}}" Tag="上" /><ComboBoxItem Content="{Binding Source=右上, Converter={StaticResource LocalizationConverter}}" Tag="右上" />
                                    <ComboBoxItem Content="{Binding Source=左, Converter={StaticResource LocalizationConverter}}" Tag="左" /><ComboBoxItem Content="{Binding Source=中心, Converter={StaticResource LocalizationConverter}}" Tag="中心" /><ComboBoxItem Content="{Binding Source=右, Converter={StaticResource LocalizationConverter}}" Tag="右" />
                                    <ComboBoxItem Content="{Binding Source=左下, Converter={StaticResource LocalizationConverter}}" Tag="左下" /><ComboBoxItem Content="{Binding Source=下, Converter={StaticResource LocalizationConverter}}" Tag="下" /><ComboBoxItem Content="{Binding Source=右下, Converter={StaticResource LocalizationConverter}}" Tag="右下" />
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="缩放延迟（毫秒，0–3000）" />
                                <TextBox ToolTip="{Binding Source=鼠标停留多久后开始放大，0 表示立即，范围 0–3000 毫秒。, Converter={StaticResource LocalizationConverter}}" Width="{Binding ActualWidth, ElementName=DefaultWidthInput}" HorizontalAlignment="Left" Text="{Binding ZoomDelayMilliseconds, UpdateSourceTrigger=Explicit}" Margin="0,3,0,0" behaviors:CommitOnEnterOrLostFocus.IsEnabled="True" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </controls:CutCornerPanel>

                <controls:CutCornerPanel Style="{StaticResource CardStyle}" Header="叠加层与隐私"
                                         Icon="{StaticResource ShieldIconGeometry}" SectionCode="OVERLAY / 04">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <CheckBox ToolTip="{Binding Source=开启后在缩略图上显示客户端名称。, Converter={StaticResource LocalizationConverter}}" Content="显示客户端名称" IsChecked="{Binding ShowNames}"
                                      VerticalAlignment="Center" />
                            <controls:ColorPickerBox ToolTip="{Binding Source=设置缩略图名称文字颜色；描边会自动适配文字明暗。, Converter={StaticResource LocalizationConverter}}" Grid.Column="1"
                                                     Width="{Binding ActualWidth, ElementName=DefaultWidthInput}"
                                                     HorizontalAlignment="Left"
                                                     SelectedColor="{Binding OverlayColor, Mode=TwoWay}"
                                                     Margin="12,0,0,0"
                                                     VerticalAlignment="Center" />
                        </Grid>
                        <CheckBox ToolTip="{Binding Source=开启后只显示角色名；已设置别名时别名优先。, Converter={StaticResource LocalizationConverter}}" IsChecked="{Binding ShowCharacterNameOnly}"
                                  IsEnabled="{Binding ShowNames}">
                            <TextBlock Text="只显示角色名[会被别名覆盖]">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                        <Setter Property="Foreground" Value="{StaticResource SecondaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ShowNames}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </CheckBox>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="字体大小（10–32）" />
                                <TextBox ToolTip="{Binding Source=缩略图名称字体大小，范围 10–32。, Converter={StaticResource LocalizationConverter}}" Width="{Binding ActualWidth, ElementName=DefaultWidthInput}" HorizontalAlignment="Left" Text="{Binding OverlayFontSize, UpdateSourceTrigger=Explicit}" Margin="0,3,0,0" behaviors:CommitOnEnterOrLostFocus.IsEnabled="True" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="名称位置" />
                                <ComboBox ToolTip="{Binding Source=选择缩略图名称的显示位置。, Converter={StaticResource LocalizationConverter}}" Width="{Binding ActualWidth, ElementName=DefaultWidthInput}" HorizontalAlignment="Left" SelectedValuePath="Tag" SelectedValue="{Binding OverlayPosition}" Margin="0,3,0,0">
                                    <ComboBoxItem Content="{Binding Source=左上, Converter={StaticResource LocalizationConverter}}" Tag="左上" /><ComboBoxItem Content="{Binding Source=中上, Converter={StaticResource LocalizationConverter}}" Tag="中上" /><ComboBoxItem Content="{Binding Source=右上, Converter={StaticResource LocalizationConverter}}" Tag="右上" />
                                    <ComboBoxItem Content="{Binding Source=左下, Converter={StaticResource LocalizationConverter}}" Tag="左下" /><ComboBoxItem Content="{Binding Source=中下, Converter={StaticResource LocalizationConverter}}" Tag="中下" /><ComboBoxItem Content="{Binding Source=右下, Converter={StaticResource LocalizationConverter}}" Tag="右下" />
                                    <ComboBoxItem Content="{Binding Source=中间, Converter={StaticResource LocalizationConverter}}" Tag="中间" />
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                        <Border Height="8" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <CheckBox ToolTip="{Binding Source=开启后为当前活动客户端显示高亮边框。, Converter={StaticResource LocalizationConverter}}" Content="高亮当前活动客户端" IsChecked="{Binding HighlightActiveClient}"
                                      VerticalAlignment="Center" />
                            <controls:ColorPickerBox ToolTip="{Binding Source=设置活动客户端的高亮边框颜色。, Converter={StaticResource LocalizationConverter}}" Grid.Column="1"
                                                     Width="{Binding ActualWidth, ElementName=DefaultWidthInput}"
                                                     HorizontalAlignment="Left"
                                                     SelectedColor="{Binding HighlightColor, Mode=TwoWay}"
                                                     Margin="12,0,0,0"
                                                     VerticalAlignment="Center" />
                        </Grid>
                        <Border Height="8" />
                        <CheckBox ToolTip="{Binding Source=开启后用占位层遮挡所有缩略图原始画面，并停止画面采集。, Converter={StaticResource LocalizationConverter}}" Content="启动全局隐私遮挡层" IsChecked="{Binding PrivacyMask}" />
                    </StackPanel>
                </controls:CutCornerPanel>

                <controls:CutCornerPanel Style="{StaticResource CardStyle}" Header="对齐与吸附"
                                         Icon="{StaticResource LayoutIconGeometry}" SectionCode="ALIGNMENT / 05">
                    <StackPanel>
                        <WrapPanel>
                            <CheckBox ToolTip="{Binding Source=开启后拖动结束时会吸附到缩略图所属显示器的工作区边缘；与网格吸附互斥。, Converter={StaticResource LocalizationConverter}}" Content="边缘吸附" IsChecked="{Binding SnapToEdges}" />
                            <CheckBox ToolTip="{Binding Source=开启后拖动结束时会按网格间距吸附；与边缘吸附互斥。, Converter={StaticResource LocalizationConverter}}" Content="网格吸附" IsChecked="{Binding SnapToGrid}" Margin="12,5" />
                        </WrapPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="X 网格尺寸（1–512 像素）" />
                                <TextBox ToolTip="{Binding Source=网格水平间距，单位物理像素，范围 1–512。, Converter={StaticResource LocalizationConverter}}" Width="{Binding ActualWidth, ElementName=DefaultWidthInput}" HorizontalAlignment="Left" Text="{Binding GridSizeX, UpdateSourceTrigger=Explicit}" Margin="0,3,0,0" behaviors:CommitOnEnterOrLostFocus.IsEnabled="True" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Y 网格尺寸（1–512 像素）" />
                                <TextBox ToolTip="{Binding Source=网格垂直间距，单位物理像素，范围 1–512。, Converter={StaticResource LocalizationConverter}}" Width="{Binding ActualWidth, ElementName=DefaultWidthInput}" HorizontalAlignment="Left" Text="{Binding GridSizeY, UpdateSourceTrigger=Explicit}" Margin="0,3,0,0" behaviors:CommitOnEnterOrLostFocus.IsEnabled="True" />
                            </StackPanel>
                        </Grid>
                        <CheckBox ToolTip="{Binding Source=开启后缩略图会被限制在所属显示器工作区内，避免拖出后无法找回。, Converter={StaticResource LocalizationConverter}}" Content="限制预览位置在屏幕可见范围内" IsChecked="{Binding HideWhenOutOfBounds}" />
                        <Grid Margin="0,3,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="越界时保留的像素" Style="{StaticResource FieldLabelTextStyle}" />
                            <TextBox ToolTip="{Binding Source=越界时至少保留多少物理像素可见，范围 0–1000。, Converter={StaticResource LocalizationConverter}}" Grid.Column="1" Width="{Binding ActualWidth, ElementName=DefaultWidthInput}" HorizontalAlignment="Left" Text="{Binding ExpansionThreshold, UpdateSourceTrigger=Explicit}" behaviors:CommitOnEnterOrLostFocus.IsEnabled="True" />
                        </Grid>
                    </StackPanel>
                </controls:CutCornerPanel>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>
</ResourceDictionary>
