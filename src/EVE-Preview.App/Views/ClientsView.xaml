<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:EvePreview.App.Controls"
                    xmlns:vm="clr-namespace:EvePreview.App.ViewModels"
                    xmlns:behaviors="clr-namespace:EvePreview.App.Behaviors">
    <DataTemplate DataType="{x:Type vm:ClientsViewModel}">
        <Grid x:Name="ClientPageRoot">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ListBox ItemsSource="{Binding Clients}"
                     SelectedItem="{Binding SelectedClient}"
                     MinHeight="240"
                     Margin="0,-2"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Margin" Value="3,3" />
                        <Setter Property="Padding" Value="10,6" />
                        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="ItemBorder"
                                            Background="#5C101E29"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource SmallRadius}"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#1C3040" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background"
                                                    Value="{StaticResource NavigationActiveGradientBrush}" />
                                            <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#2A4C5A" />
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="ItemBorder" Property="Opacity" Value="0.55" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding CharacterName}"
                                       
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding ServerName}"
                                       Style="{StaticResource CaptionTextStyle}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding OnlineStatusText}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionTextStyle}">
                                        <Setter Property="Foreground" Value="{StaticResource SecondaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <controls:CutCornerPanel Grid.Column="2" Style="{StaticResource CardStyle}" Margin="0"
                                     Header="客户端属性" Icon="{StaticResource ClientIconGeometry}" SectionCode="CLIENT PROPERTIES">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel DataContext="{Binding SelectedClient}">
                        <TextBlock Text="{Binding OnlineStatusText}" Style="{StaticResource StatusTextStyle}" />
                        <TextBlock Text="{Binding OnlineStatusDetail}" Style="{StaticResource CaptionTextStyle}"
                                   Margin="0,3,0,8" />
                        <TextBlock Text="{Binding PlacementText}" Style="{StaticResource CaptionTextStyle}"
                                   Margin="0,0,0,4" />
                        <TextBlock Text="{Binding ClientWindowLayoutText}" Style="{StaticResource CaptionTextStyle}"
                                   Margin="0,0,0,8" />
                        <WrapPanel Margin="0,0,0,8">
                            <Button ToolTip="{Binding Source=保存当前客户端的窗口位置和大小。, Converter={StaticResource LocalizationConverter}}" Content="保存窗口布局" Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding DataContext.SaveSelectedLayoutCommand,
                                              ElementName=ClientPageRoot}" />
                            <Button ToolTip="{Binding Source=将已保存的窗口位置和大小应用到当前客户端。, Converter={StaticResource LocalizationConverter}}" Content="应用窗口布局" Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding DataContext.ApplySelectedLayoutCommand,
                                              ElementName=ClientPageRoot}" />
                            <Button ToolTip="{Binding Source=客户端离线时删除其配置；在线时清空该客户端的所有设置。, Converter={StaticResource LocalizationConverter}}" Content="删除设置" Style="{StaticResource SecondaryButtonStyle}"
                                    MinWidth="0" Padding="12,0"
                                    Command="{Binding DataContext.DeleteSelectedSettingsCommand,
                                              ElementName=ClientPageRoot}" />
                        </WrapPanel>
                        <TextBlock Text="{Binding DataContext.LayoutStatusText,
                                          ElementName=ClientPageRoot}"
                                   Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,8" />

                        <StackPanel>
                            <TextBlock Text="显示别名" />
                            <Grid Margin="0,3,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="135" />
                                    <ColumnDefinition Width="40" />
                                </Grid.ColumnDefinitions>
                                <TextBox ToolTip="{Binding Source=设置此客户端的显示别名；留空则显示角色名或客户端窗口标题。, Converter={StaticResource LocalizationConverter}}" Grid.ColumnSpan="3"
                                         Text="{Binding Alias, UpdateSourceTrigger=Explicit}" behaviors:CommitOnEnterOrLostFocus.IsEnabled="True" />
                            </Grid>
                        </StackPanel>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="135" />
                                <ColumnDefinition Width="40" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="高亮颜色" />
                                <Grid Margin="0,3,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <controls:ColorPickerBox ToolTip="{Binding Source=设置此客户端的高亮颜色；留空时继承全局高亮色。, Converter={StaticResource LocalizationConverter}}" SelectedColor="{Binding HighlightColor, Mode=TwoWay}"
                                                             AllowEmpty="True"
                                                             EmptyText="未选择" />
                                </Grid>
                                <TextBlock Text="留空使用全局高亮色"
                                           Style="{StaticResource CaptionTextStyle}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Grid.ColumnSpan="2">
                                <TextBlock Text="独立热键" />
                                <TextBox ToolTip="{Binding Source=录制此客户端的独立全局热键；Esc 恢复原值，留空禁用。, Converter={StaticResource LocalizationConverter}}" Width="135" HorizontalAlignment="Left" Margin="0,3,0,0"
                                         Text="{Binding HotKey, UpdateSourceTrigger=PropertyChanged}"
                                         FontFamily="{StaticResource MonospaceFontFamily}"
                                         behaviors:HotkeyRecorder.IsEnabled="True" />
                                <TextBlock Text="例如 Ctrl+Shift+1；不支持鼠标按键"
                                           Style="{StaticResource CaptionTextStyle}" />
                                <TextBlock Text="{Binding DataContext.Hotkeys.DuplicateText, RelativeSource={RelativeSource AncestorType=Window}}"
                                           Style="{StaticResource ErrorTextStyle}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>

                        <CheckBox ToolTip="{Binding Source=开启后此客户端不会出现在循环组候选项和循环中。, Converter={StaticResource LocalizationConverter}}" Content="从循环组候选中排除" IsChecked="{Binding ExcludeFromCycle}" />
                        <CheckBox ToolTip="{Binding Source=开启后遮挡此客户端的缩略图原始画面并停止采集。, Converter={StaticResource LocalizationConverter}}" Content="对该客户端启用隐私遮挡" IsChecked="{Binding PrivacyMask}" />
                        <CheckBox ToolTip="{Binding Source=开启后不再为这个客户端显示缩略图。, Converter={StaticResource LocalizationConverter}}" Content="禁用该客户端的缩略图显示" IsChecked="{Binding DisablePreview}" />
                    </StackPanel>
                </ScrollViewer>
            </controls:CutCornerPanel>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
