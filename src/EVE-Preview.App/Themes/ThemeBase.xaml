<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:EvePreview.App.Controls"
                    xmlns:services="clr-namespace:EvePreview.App.Services">
    <!-- DESIGN.md tokens: 1 px = 1 WPF DIP at 96 DPI. -->
    <Color x:Key="PrimaryColor">#63D8E8</Color>
    <Color x:Key="SecondaryColor">#8297A5</Color>
    <Color x:Key="TertiaryColor">#D7AD68</Color>
    <Color x:Key="NeutralColor">#05090D</Color>
    <Color x:Key="SurfaceColor">#080E14</Color>
    <Color x:Key="SurfaceRaisedColor">#101E29</Color>
    <Color x:Key="TextColor">#D3E0E7</Color>
    <Color x:Key="SuccessColor">#6BD7AE</Color>
    <Color x:Key="DangerColor">#FF8585</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource SecondaryColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource TertiaryColor}" />
    <SolidColorBrush x:Key="WindowBrush" Color="{StaticResource NeutralColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="{StaticResource SurfaceRaisedColor}" />
    <SolidColorBrush x:Key="PanelBrush" Color="#F00A131B" />
    <SolidColorBrush x:Key="TitleBarBrush" Color="#FA060C11" />
    <SolidColorBrush x:Key="SidebarBrush" Color="#7305090D" />
    <SolidColorBrush x:Key="StatusBarBrush" Color="#9905090D" />
    <SolidColorBrush x:Key="FieldBrush" Color="#070E14" />
    <SolidColorBrush x:Key="FaintBrush" Color="#587080" />
    <SolidColorBrush x:Key="NavigationActiveBrush" Color="#153440" />
    <SolidColorBrush x:Key="NavigationActiveTextBrush" Color="#A4F2F7" />
    <SolidColorBrush x:Key="EveTitleBrush" Color="#E5F2F5" />
    <SolidColorBrush x:Key="EveAccentDimBrush" Color="#315563" />
    <SolidColorBrush x:Key="PreviewToolTipTextBrush" Color="#F3F6F8" />
    <SolidColorBrush x:Key="PreviewToolTipBackgroundBrush" Color="#303030" />
    <services:LocalizationConverter x:Key="LocalizationConverter" />
    <SolidColorBrush x:Key="PrimaryButtonBrush" Color="#112832" />
    <SolidColorBrush x:Key="PrimaryButtonHoverBrush" Color="#173945" />
    <SolidColorBrush x:Key="PrimaryButtonBorderBrush" Color="#3E7A8C" />
    <SolidColorBrush x:Key="PrimaryButtonTextBrush" Color="#A4F2F7" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="#203543" />
    <SolidColorBrush x:Key="PanelDividerBrush" Color="#BF203543" />
    <SolidColorBrush x:Key="SidebarBorderBrush" Color="#99203543" />
    <SolidColorBrush x:Key="StatusBarBorderBrush" Color="#99203543" />
    <SolidColorBrush x:Key="ContentLineBrush" Color="#BF203543" />
    <SolidColorBrush x:Key="CutCornerStrokeBrush" Color="#466273" />
    <SolidColorBrush x:Key="StatusPanelBrush" Color="#F20C1E26" />
    <SolidColorBrush x:Key="StatusPanelBorderBrush" Color="#2B515E" />
    <SolidColorBrush x:Key="TitleBarButtonBorderBrush" Color="#73203543" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#345466" />
    <SolidColorBrush x:Key="ButtonBrush" Color="#0B171F" />
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="#12222C" />
    <LinearGradientBrush x:Key="NavigationActiveGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#173945" Offset="0" />
        <GradientStop Color="#112832" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BackgroundShadeBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#6305090D" Offset="0" />
        <GradientStop Color="#1405090D" Offset="0.45" />
        <GradientStop Color="#4005090D" Offset="1" />
    </LinearGradientBrush>

    <FontFamily x:Key="AppFontFamily">Bahnschrift SemiCondensed, Microsoft YaHei UI</FontFamily>
    <FontFamily x:Key="EveDisplayFontFamily">Bahnschrift SemiCondensed, Microsoft YaHei UI</FontFamily>
    <FontFamily x:Key="MonospaceFontFamily">Bahnschrift SemiCondensed, Microsoft YaHei UI</FontFamily>
    <CornerRadius x:Key="SmallRadius">2</CornerRadius>
    <CornerRadius x:Key="MediumRadius">4</CornerRadius>
    <Thickness x:Key="PageMargin">16</Thickness>
    <Thickness x:Key="CardPadding">15</Thickness>

    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="SectionTitleTextStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Margin" Value="0" />
    </Style>
    <Style x:Key="CaptionTextStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource SecondaryBrush}" />
        <Setter Property="LineHeight" Value="15" />
    </Style>
    <Style x:Key="FieldLabelTextStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,8,0" />
    </Style>
    <Style x:Key="ErrorTextStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
        <Setter Property="Margin" Value="0,3,0,0" />
    </Style>
    <Style x:Key="StatusTextStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
    </Style>
    <Style x:Key="WarningStatusTextStyle" TargetType="TextBlock" BasedOn="{StaticResource StatusTextStyle}">
        <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
    </Style>

    <Style x:Key="IconPathStyle" TargetType="Path">
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="StrokeThickness" Value="1.55" />
        <Setter Property="StrokeStartLineCap" Value="Square" />
        <Setter Property="StrokeEndLineCap" Value="Square" />
        <Setter Property="StrokeLineJoin" Value="Miter" />
        <Setter Property="Fill" Value="Transparent" />
    </Style>
    <Style x:Key="SectionIconStyle" TargetType="Path" BasedOn="{StaticResource IconPathStyle}">
        <Setter Property="Width" Value="14" />
        <Setter Property="Height" Value="14" />
        <Setter Property="Margin" Value="0,0,7,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Stroke" Value="{StaticResource PrimaryBrush}" />
    </Style>

    <Style x:Key="CardStyle" TargetType="controls:CutCornerPanel">
        <Setter Property="Background" Value="{StaticResource PanelBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="{StaticResource CardPadding}" />
        <Setter Property="Margin" Value="0,0,0,13" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:CutCornerPanel">
                    <controls:CutCornerBorder Background="{TemplateBinding Background}"
                                              BorderBrush="{TemplateBinding BorderBrush}"
                                              BorderThickness="{TemplateBinding BorderThickness}"
                                              CutCornerBrush="{StaticResource WindowBrush}"
                                              CutCornerStroke="{StaticResource CutCornerStrokeBrush}"
                                              CutCornerSize="15"
                                              SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border x:Name="PanelHeader" MinHeight="41" Padding="15,0"
                                    BorderBrush="{StaticResource PanelDividerBrush}" BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Path Data="{TemplateBinding Icon}" Style="{StaticResource SectionIconStyle}"
                                          Width="16" Height="16" Margin="0,0,9,0" StrokeThickness="1.4" />
                                    <ContentPresenter Grid.Column="1" ContentSource="Header"
                                                      VerticalAlignment="Center" RecognizesAccessKey="True">
                                        <ContentPresenter.Resources>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                <Setter Property="FontSize" Value="15" />
                                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                                <Setter Property="TextWrapping" Value="NoWrap" />
                                            </Style>
                                        </ContentPresenter.Resources>
                                    </ContentPresenter>
                                    <TextBlock Grid.Column="3" Text="{TemplateBinding SectionCode}"
                                               FontSize="9" Foreground="{StaticResource FaintBrush}"
                                               VerticalAlignment="Center" TextWrapping="NoWrap" />
                                </Grid>
                            </Border>
                            <Border Grid.Row="1" Padding="{TemplateBinding Padding}">
                                <ContentPresenter ContentSource="Content"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Border>
                        </Grid>
                    </controls:CutCornerBorder>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasHeader" Value="False">
                            <Setter TargetName="PanelHeader" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="StatusCardStyle" TargetType="controls:CutCornerPanel" BasedOn="{StaticResource CardStyle}">
        <Setter Property="Background" Value="{StaticResource StatusPanelBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource StatusPanelBorderBrush}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,0,0,14" />
    </Style>

    <Style x:Key="ClientCardStyle" TargetType="Border">
        <Setter Property="Background" Value="#C70A131B" />
        <Setter Property="BorderBrush" Value="#59203543" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource SmallRadius}" />
        <Setter Property="Width" Value="240" />
        <Setter Property="Margin" Value="0,0,10,10" />
        <Setter Property="Padding" Value="12" />
    </Style>

    <Style TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Height" Value="32" />
        <Setter Property="MinWidth" Value="80" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Background" Value="{StaticResource ButtonBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource PrimaryButtonBrush}" />
        <Setter Property="Foreground" Value="{StaticResource PrimaryButtonTextBrush}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Border" Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource SmallRadius}" Padding="{TemplateBinding Padding}"
                            BorderBrush="{StaticResource PrimaryButtonBorderBrush}" BorderThickness="1">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="{StaticResource PrimaryButtonHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="#173646" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                            <Setter TargetName="Border" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Border" Property="Opacity" Value="0.55" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Border" Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource SmallRadius}" Padding="{TemplateBinding Padding}"
                            BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="{StaticResource ButtonHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="#263F52" />
                            <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                            <Setter TargetName="Border" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Border" Property="Opacity" Value="0.55" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="NavigationButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
        <Setter Property="Height" Value="45" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Margin" Value="8,4" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource SecondaryBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock Text="{Binding}"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                               FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                               FontWeight="{Binding FontWeight, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                               TextWrapping="NoWrap" VerticalAlignment="Center" />
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <Border x:Name="Border" Background="{TemplateBinding Background}"
                                CornerRadius="{StaticResource SmallRadius}" Padding="{TemplateBinding Padding}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Path Width="17" Height="17" HorizontalAlignment="Left" VerticalAlignment="Center"
                                      Data="{TemplateBinding Tag}" Style="{StaticResource IconPathStyle}"
                                      Stroke="{TemplateBinding Foreground}" />
                                <ContentPresenter Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  RecognizesAccessKey="True" />
                                <TextBlock x:Name="IndexText" Grid.Column="2"
                                           Text="{TemplateBinding controls:NavigationButtonProperties.Index}"
                                           FontSize="10" Foreground="{StaticResource FaintBrush}"
                                           TextWrapping="NoWrap" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <Border x:Name="SelectionIndicator" Width="2" Height="29"
                                Margin="-9,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                                Background="{StaticResource PrimaryBrush}" Visibility="Collapsed">
                            <Border.Effect>
                                <DropShadowEffect Color="#63D8E8" BlurRadius="8" ShadowDepth="0" Opacity="0.45" />
                            </Border.Effect>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="#731A313D" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="#263F52" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Border" Property="Opacity" Value="0.55" />
                        </Trigger>
                        <Trigger Property="controls:NavigationButtonProperties.IsCurrent" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="{StaticResource NavigationActiveGradientBrush}" />
                            <Setter TargetName="Border" Property="BorderBrush" Value="#2A4C5A" />
                            <Setter TargetName="IndexText" Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                            <Setter TargetName="SelectionIndicator" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GroupDeleteButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="#607480" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="2">
                        <Path Data="{StaticResource CloseIconGeometry}" Style="{StaticResource IconPathStyle}"
                              Stroke="{TemplateBinding Foreground}" Width="10" Height="10" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="#B8C5CB" />
                            <Setter TargetName="Chrome" Property="Background" Value="#732D414C" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource NavigationActiveTextBrush}" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                            <Setter TargetName="Chrome" Property="BorderThickness" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
